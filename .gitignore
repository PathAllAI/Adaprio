# Dependencies (regenerated by `pnpm install` — never commit)
node_modules/

# Build output (regenerated by `pnpm typecheck` / `pnpm build`)
dist/
*.tsbuildinfo

# Wrangler (Cloudflare Workers CLI) local state/cache
.wrangler/

# Secrets — never commit real values. .dev.vars.example stays tracked.
.dev.vars
*.env
.env
.env.local

# Logs
npm-debug.log*
pnpm-debug.log*
*.log

# OS-generated files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp

# Test/coverage output
coverage/
